# ===================================================
# EcoGrid Environment Variables Configuration
# ===================================================

# Backend Node.js Service
PORT=5001
NODE_ENV=development
# PostgreSQL is used for both local development and production.
# Keep this URL on localhost for the host-run backend. Docker Compose builds
# its internal URL with host "db" from the POSTGRES_* values below.
DATABASE_URL="postgresql://ecogrid:replace-with-local-password@localhost:5432/ecogrid_db?schema=public"
POSTGRES_USER=ecogrid
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=ecogrid_db

JWT_SECRET="replace-with-a-long-random-secret"
PYTHON_SERVICE_URL="http://127.0.0.1:8000"
IMPORT_SERVICE_TOKEN="replace-with-a-long-random-internal-token"
IMPORT_STORAGE_DIR="./imports"
CORS_ORIGIN="http://localhost:5173"

# Frontend Vite
VITE_API_URL="http://localhost:5001/api/v1"

# Intelligence Python Service
INTELLIGENCE_PORT=8000
