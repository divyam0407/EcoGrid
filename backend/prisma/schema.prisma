datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  industryType String   @default("HIGHER_EDUCATION") // HIGHER_EDUCATION, MANUFACTURING, HOSPITAL, COMMERCIAL
  address      String?
  timezone     String   @default("UTC")
  currency     String   @default("USD")
  tier         String   @default("COMMERCIAL_PRODUCTION") // OrganizationTier: DEMO_SANDBOX, RESEARCH_BENCHMARK, COMMERCIAL_PRODUCTION
  isBenchmark  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members         OrganizationMember[]
  buildings       Building[]
  meters          Meter[]
  energyReadings  EnergyReading[]
  schedules       OperationalSchedule[]
  calendarEvents  AcademicCalendarEvent[]
  operationalInsights OperationalInsight[]
  tariffs         ElectricityTariff[]
  solar           SolarInstallation[]
  batteries       Battery[]
  predictions     Prediction[]
  anomalies       Anomaly[]
  recommendations Recommendation[]
  optimizations   OptimizationRun[]
  scenarios       Scenario[]
  auditLogs       AuditLog[]
  recommendationEvents RecommendationEvent[]
  recommendationMeasurements RecommendationMeasurement[]
  importBatches   DataImportBatch[]
  benchmarkRuns   BenchmarkEvaluationRun[]
  forecastModels  ForecastModel[]
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMember[]
  auditLogs   AuditLog[]
  assignedRecommendations Recommendation[] @relation("RecommendationAssignee")
  approvedRecommendations Recommendation[] @relation("RecommendationApprover")
  recommendationEvents RecommendationEvent[]
  recommendationMeasurements RecommendationMeasurement[]
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("ENERGY_MANAGER") // SUPER_ADMIN, ORG_ADMIN, ENERGY_MANAGER, DEPT_MANAGER, VIEWER
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Building {
  id                String   @id @default(uuid())
  organizationId    String
  name              String
  buildingType      String   @default("ACADEMIC") // ACADEMIC, LAB, LIBRARY, RESIDENTIAL, AUDITORIUM
  address           String?
  totalArea         Float?
  externalId        String? // Source-specific building ID (e.g., IIITD_Academic_Block, UnivClass_Theresa)
  siteId            String? // Site identifier (e.g., Site_0, IIITD_Okhla)
  yearBuilt         Int?
  floorCount        Int?
  primarySpaceUsage String? // Standardized space usage (Education, Office, Lab, Lodging, etc.)
  dataSource        String   @default("SYNTHETIC_DEMO") // DataSourceType
  createdAt         DateTime @default(now())

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments      Department[]
  rooms            Room[]
  meters           Meter[]
  energyReadings   EnergyReading[]
  schedules        OperationalSchedule[]
  calendarEvents   AcademicCalendarEvent[]
  operationalInsights OperationalInsight[]
  occupancyRecords OccupancyRecord[]
  solar            SolarInstallation[]
  batteries        Battery[]
  predictions      Prediction[]
  anomalies        Anomaly[]
  recommendations  Recommendation[]
  optimizations    OptimizationRun[]
  forecastModels   ForecastModel[]
}

model Department {
  id             String @id @default(uuid())
  organizationId String
  buildingId     String
  name           String
  departmentType String @default("ACADEMIC")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    Room[]
  schedules OperationalSchedule[]
  calendarEvents AcademicCalendarEvent[]
}

model Room {
  id                     String  @id @default(uuid())
  organizationId         String
  buildingId             String
  departmentId           String?
  roomNumber             String
  roomType               String  @default("CLASSROOM") // CLASSROOM, COMPUTER_LAB, RESEARCH_LAB, AUDITORIUM, OFFICE
  capacity               Int     @default(30)
  floor                  Int     @default(1)
  expectedOperatingHours String  @default("08:00-18:00")

  building         Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  department       Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  meters           Meter[]
  schedules        OperationalSchedule[]
  calendarEvents   AcademicCalendarEvent[]
  operationalInsights OperationalInsight[]
  recommendations Recommendation[]
  occupancyRecords OccupancyRecord[]
  anomalies        Anomaly[]
  energyReadings   EnergyReading[]
}

model Meter {
  id               String  @id @default(uuid())
  organizationId   String
  buildingId       String
  roomId           String?
  meterName        String
  meterType        String  @default("MAIN_FEEDER") // MAIN_FEEDER, SUB_METER, HVAC, LIGHTING, PLUG_LOAD
  sourceType       String  @default("MANUAL_CSV") // MANUAL_CSV, IOT_MQTT, MODBUS
  unit             String  @default("kWh")
  status           String  @default("ACTIVE")
  externalMeterId  String? // Source-specific meter ID (e.g., meter_0, AHU_Feeder_M01)
  physicalLocation String?
  multiplier       Float   @default(1.0)
  dataSource       String  @default("SYNTHETIC_DEMO") // DataSourceType

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  room         Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  readings     EnergyReading[]
  anomalies    Anomaly[]
  recommendations Recommendation[]
  recommendationMeasurements RecommendationMeasurement[]
  predictions     Prediction[]
  forecastModels  ForecastModel[]
}

model EnergyReading {
  id                       String   @id @default(uuid())
  organizationId           String
  meterId                  String
  buildingId               String
  roomId                   String?
  batchId                  String?
  timestamp                DateTime // Canonical UTC timestamp
  sourceLocalTime          String? // Original local timestamp string from source
  sourceExternalBuildingId String?
  sourceExternalMeterId    String?
  consumptionKwh           Float // Normalized interval energy in kWh
  powerKw                  Float? // Average interval power in kW
  rawReading               Float? // Original un-scaled/un-differenced reading
  rawUnit                  String? // Original instrument unit (W, Wh, kWh, cumulative_kWh)
  voltageV                 Float? // Volts (e.g., I-BLEND 1-min telemetry)
  currentA                 Float? // Amperes
  frequencyHz              Float? // Grid frequency (Hz)
  powerFactor              Float? // Power factor (0.0 - 1.0)
  apparentPowerVa          Float? // Apparent power (VA)
  reactivePowerVar         Float? // Reactive power (VAR)
  intervalMinutes          Int      @default(60)
  dataSource               String   @default("SYNTHETIC_DEMO") // DataSourceType
  source                   String   @default("CSV_UPLOAD")
  qualityStatus            String   @default("VALIDATED") // DataQualityStatus: MEASURED, CALCULATED_INTERVAL, ESTIMATED_IMPUTED, FLAGGED_OUTLIER, METER_RESET_ROLLOVER, INVALID_REJECTED, VALIDATED
  createdAt                DateTime @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meter        Meter            @relation(fields: [meterId], references: [id], onDelete: Cascade)
  building     Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  room         Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  batch        DataImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([organizationId, meterId, timestamp])
  @@index([organizationId, timestamp])
  @@index([buildingId, timestamp])
  @@index([meterId, timestamp])
  @@index([batchId])
  @@index([organizationId, dataSource, timestamp])
}

model OperationalSchedule {
  id                String    @id @default(uuid())
  organizationId    String
  buildingId        String
  roomId            String
  activityName      String
  activityType      String    @default("LECTURE") // LECTURE, LAB_SESSION, EXAMINATION, EVENT, MAINTENANCE
  startDatetime     DateTime?
  endDatetime       DateTime?
  dayOfWeek         Int? // 0 = Monday, 6 = Sunday
  startTime         String // "09:00"
  endTime           String // "11:00"
  expectedOccupancy Int       @default(30)
  sourceType        String    @default("TIMETABLE_CSV")
  timezone          String    @default("UTC")
  recurrenceRule    String    @default("NONE") // NONE, WEEKLY
  recurrenceEnd     DateTime?
  status            String    @default("ACTIVE") // ACTIVE, CANCELLED
  departmentId      String?
  importBatchId     String?
  sourceRow         Int?
  recordKey         String?
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  importBatch  DataImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([organizationId, buildingId, roomId])
  @@index([organizationId, status, dayOfWeek])
  @@index([importBatchId])
  @@unique([organizationId, recordKey])
}

model AcademicCalendarEvent {
  id             String   @id @default(uuid())
  organizationId String
  buildingId     String?
  departmentId   String?
  roomId         String?
  title          String
  eventType      String // HOLIDAY, EXAMINATION, VACATION, SPECIAL_EVENT
  startDatetime  DateTime
  endDatetime    DateTime
  timezone       String
  allDay         Boolean  @default(false)
  status         String   @default("ACTIVE") // ACTIVE, CANCELLED
  sourceType     String   @default("MANUAL_ENTRY")
  importBatchId  String?
  sourceRow      Int?
  recordKey      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  room         Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  importBatch  DataImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([organizationId, startDatetime, endDatetime])
  @@index([organizationId, eventType, status])
  @@index([buildingId, startDatetime])
  @@index([roomId, startDatetime])
  @@index([importBatchId])
  @@unique([organizationId, recordKey])
}

model OperationalInsight {
  id                String   @id @default(uuid())
  organizationId    String
  buildingId        String?
  roomId            String?
  category          String
  title             String
  reason            String
  recommendation    String
  periodStart       DateTime
  periodEnd         DateTime
  observedEnergyKwh Float?
  estimatedSavingsKwh Float?
  estimatedSavingsCost Float?
  confidence        String   @default("LIMITED_EVIDENCE")
  evidenceJson      String
  limitationsJson   String
  status            String   @default("NEW") // NEW, REVIEWED, DISMISSED, ACTIONED
  approvalStatus    String   @default("NOT_REQUESTED")
  outcomeJson       String?
  sourceKey         String?
  generatorVersion  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  room         Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  recommendations Recommendation[]

  @@index([organizationId, status, createdAt])
  @@index([buildingId, periodStart])
  @@index([roomId, periodStart])
  @@unique([organizationId, sourceKey])
}

model OccupancyRecord {
  id                       String   @id @default(uuid())
  organizationId           String
  buildingId               String?
  roomId                   String?
  batchId                  String?
  timestamp                DateTime
  sourceLocalTime          String?
  sourceExternalBuildingId String?
  occupancyCount           Int
  sourceType               String   @default("ESTIMATED") // SCHEDULED, WIFI_ASSOCIATION, PIR_SENSOR, MANUAL, ESTIMATED
  granularity              String   @default("BUILDING_LEVEL") // BUILDING_LEVEL, FLOOR_LEVEL, ROOM_LEVEL
  dataSource               String   @default("SYNTHETIC_DEMO") // DataSourceType
  confidence               Float    @default(0.9)

  building Building?        @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  room     Room?            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  batch    DataImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([roomId, timestamp])
  @@index([buildingId, timestamp])
  @@index([batchId])
}

model ElectricityTariff {
  id             String    @id @default(uuid())
  organizationId String
  tariffName     String
  tariffType     String    @default("TIME_OF_USE") // FLAT, TIME_OF_USE, TIERED, DEMAND_PEAK
  pricePerKwh    Float     @default(0.15)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periods      TariffPeriod[]
}

model TariffPeriod {
  id          String @id @default(uuid())
  tariffId    String
  periodName  String @default("STANDARD") // OFF_PEAK, STANDARD, PEAK
  startTime   String // "00:00"
  endTime     String // "06:00"
  pricePerKwh Float
  dayType     String @default("ALL") // WEEKDAY, WEEKEND, ALL

  tariff ElectricityTariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)
}

model SolarInstallation {
  id               String   @id @default(uuid())
  organizationId   String
  buildingId       String
  capacityKw       Float    @default(100.0)
  installationDate DateTime @default(now())
  status           String   @default("ACTIVE")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  readings     SolarReading[]
}

model SolarReading {
  id             String   @id @default(uuid())
  organizationId String
  installationId String
  timestamp      DateTime
  generationKwh  Float
  powerKw        Float?

  installation SolarInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId, timestamp])
}

model Battery {
  id                    String @id @default(uuid())
  organizationId        String
  buildingId            String
  name                  String @default("Main Storage Bank")
  capacityKwh           Float  @default(150.0)
  maxChargeKw           Float  @default(40.0)
  maxDischargeKw        Float  @default(40.0)
  minSoc                Float  @default(15.0)
  maxSoc                Float  @default(140.0)
  initialSoc            Float  @default(30.0)
  chargingEfficiency    Float  @default(0.92)
  dischargingEfficiency Float  @default(0.92)
  degradationCost       Float  @default(0.015)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building         @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  readings     BatteryReading[]
}

model BatteryReading {
  id               String   @id @default(uuid())
  organizationId   String
  batteryId        String
  timestamp        DateTime
  stateOfCharge    Float
  chargePowerKw    Float    @default(0)
  dischargePowerKw Float    @default(0)

  battery Battery @relation(fields: [batteryId], references: [id], onDelete: Cascade)

  @@index([batteryId, timestamp])
}

model Prediction {
  id                String   @id @default(uuid())
  organizationId    String
  buildingId        String
  modelVersion      String   @default("v1.2-operational-aware")
  predictionType    String   @default("24_HOUR_DEMAND")
  forecastTimestamp DateTime
  predictedKwh      Float
  dataSource        String   @default("SYNTHETIC_DEMO")
  actualKwh         Float?
  confidenceLower   Float?
  confidenceUpper   Float?
  meterId           String?
  forecastModelId   String?
  horizonHours      Int      @default(24)
  leadHours         Int      @default(1)
  intervalMinutes   Int      @default(60)
  sourcePredictionKey String?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  meter        Meter?       @relation(fields: [meterId], references: [id], onDelete: SetNull)
  forecastModel ForecastModel? @relation(fields: [forecastModelId], references: [id], onDelete: SetNull)

  @@index([organizationId, forecastTimestamp])
  @@index([organizationId, dataSource, forecastTimestamp])
  @@unique([organizationId, sourcePredictionKey])
  @@index([organizationId, meterId, forecastTimestamp])
  @@index([organizationId, forecastModelId, horizonHours])
}

model ForecastModel {
  id                    String   @id @default(uuid())
  organizationId        String
  buildingId            String
  meterId               String
  dataSource            String
  version               Int
  algorithm             String
  status                String   @default("QUEUED") // QUEUED, TRAINING, READY, FAILED
  stage                 String   @default("QUEUED")
  progressPercent       Int      @default(0)
  isActive              Boolean  @default(false)
  featureSetJson        String
  trainingConfigJson    String
  qualityReportJson     String?
  dataProvenanceJson    String?
  metricsJson           String?
  trainStart            DateTime?
  trainEnd              DateTime?
  validationStart       DateTime?
  validationEnd         DateTime?
  testStart             DateTime?
  testEnd               DateTime?
  trainingRows          Int      @default(0)
  validationRows        Int      @default(0)
  testRows              Int      @default(0)
  artifactPath          String?
  artifactSha256        String?
  errorMessage          String?
  retryOfId             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  completedAt           DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  meter        Meter        @relation(fields: [meterId], references: [id], onDelete: Cascade)
  predictions Prediction[]

  @@unique([organizationId, meterId, dataSource, version])
  @@index([organizationId, meterId, status, createdAt])
  @@index([organizationId, meterId, dataSource, isActive])
}

model Anomaly {
  id               String   @id @default(uuid())
  organizationId   String
  buildingId       String
  meterId          String?
  roomId           String?
  anomalyType      String // SPIKE, UNSCHEDULED_SURGE, HIGH_IDLE, SUDDEN_DROP
  dataSource       String   @default("SYNTHETIC_DEMO")
  severity         String // LOW, MEDIUM, HIGH, CRITICAL
  expectedValue    Float
  observedValue    Float
  deviation        Float
  deviationPercent Float
  description      String
  suggestedAction  String?
  status           String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, FALSE_POSITIVE
  detectedAt       DateTime @default(now())
  detectionMethod  String?
  baselineSampleCount Int?
  qualityReportJson String?
  operationalContextJson String?
  sourceKey String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  meter        Meter?       @relation(fields: [meterId], references: [id], onDelete: SetNull)
  room         Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([organizationId, detectedAt])
  @@index([organizationId, dataSource, detectedAt])
  @@unique([organizationId, sourceKey])
}

model Recommendation {
  id                       String   @id @default(uuid())
  organizationId           String
  buildingId               String
  roomId                   String?
  meterId                  String?
  operationalInsightId     String?
  sourceKey                String?
  recommendationType       String // OPERATIONAL_ADJUSTMENT, PEAK_SHAVING, SOLAR_BATTERY_DISPATCH, IDLE_CUTOFF
  generationSource         String   @default("LEGACY_UNVERIFIED")
  title                    String
  description              String
  evidence                 String?
  estimatedEnergySavingKwh Decimal? @db.Decimal(18, 6)
  estimatedCostSaving      Decimal? @db.Decimal(18, 4)
  approvedSavingsTargetKwh Decimal? @db.Decimal(18, 6)
  financialEstimateAvailable Boolean @default(false)
  savingsPeriod            String?
  calculationPeriodStart   DateTime?
  calculationPeriodEnd     DateTime?
  calculationMethod        String?
  assumptionsJson          String?
  limitationsJson          String?
  priority                 String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  priorityReason           String?
  effortLevel              String?
  confidence               Float    @default(0.85)
  status                   String   @default("NEW") // NEW, UNDER_REVIEW, APPROVED, REJECTED, IN_PROGRESS, COMPLETED, DISMISSED; legacy statuses are preserved
  assignedUserId           String?
  approvedByUserId         String?
  approvedAt               DateTime?
  rejectedReason           String?
  implementedAt            DateTime?
  completionDetails        String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  room         Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  meter        Meter? @relation(fields: [meterId], references: [id], onDelete: SetNull)
  operationalInsight OperationalInsight? @relation(fields: [operationalInsightId], references: [id], onDelete: SetNull)
  assignedUser User? @relation("RecommendationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  approvedByUser User? @relation("RecommendationApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  events RecommendationEvent[]
  measurements RecommendationMeasurement[]

  @@index([organizationId, status])
  @@index([organizationId, generationSource, createdAt])
  @@index([organizationId, buildingId, priority, status])
  @@index([meterId, calculationPeriodStart, calculationPeriodEnd])
  @@unique([organizationId, sourceKey])
}

model RecommendationEvent {
  id                String   @id @default(uuid())
  organizationId    String
  recommendationId  String
  actorUserId       String?
  eventType         String
  fromStatus        String?
  toStatus          String?
  reason            String?
  note              String?
  metadataJson      String?
  createdAt         DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  actor          User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, recommendationId, createdAt])
}

model RecommendationMeasurement {
  id                         String   @id @default(uuid())
  organizationId             String
  recommendationId           String
  meterId                    String
  baselinePeriodStart        DateTime
  baselinePeriodEnd          DateTime
  comparisonPeriodStart      DateTime
  comparisonPeriodEnd        DateTime
  baselineExpectedKwh        Decimal? @db.Decimal(18, 6)
  postActionMeasuredKwh      Decimal? @db.Decimal(18, 6)
  estimatedRealizedSavingsKwh Decimal? @db.Decimal(18, 6)
  savingsStatus              String   @default("INSUFFICIENT_DATA") // INSUFFICIENT_DATA, ESTIMATED_UNVERIFIED, REVIEW_REQUIRED, OVERLAPPING_RECOMMENDATIONS
  methodology                String
  limitationsJson            String
  measuredAt                 DateTime @default(now())
  createdByUserId            String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  meter          Meter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  createdBy      User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, recommendationId, measuredAt])
}

model OptimizationRun {
  id               String   @id @default(uuid())
  organizationId   String
  buildingId       String
  optimizationType String   @default("MILP_TARIFF_BATTERY")
  baselineCost     Float
  optimizedCost    Float
  estimatedSavings Float
  solverStatus     String   @default("OPTIMAL")
  configuration    String // JSON string
  resultData       String // JSON string
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model Scenario {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  configuration  String // JSON string
  resultData     String? // JSON string
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  timestamp      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model DataImportBatch {
  id                 String    @id @default(uuid())
  organizationId     String
  dataSource         String // DataSourceType enum
  datasetName        String
  license            String
  sourceUrl          String?
  originalFilename   String
  fileSha256         String
  sourceTimezone     String
  rawUnit            String
  preprocessingVer   String
  importedAt         DateTime  @default(now())
  status             String    @default("UPLOADED")
  progressPercent    Int       @default(0)
  currentStage       String?
  requestFingerprint String?
  mappingJson        String?
  completedAt        DateTime?
  errorMessage       String?

  totalRowsProcessed Int
  validRecordsCount  Int
  imputedCount       Int       @default(0)
  flaggedCount       Int       @default(0)
  rejectedCount      Int       @default(0)
  minTimestamp       DateTime?
  maxTimestamp       DateTime?
  errorLogJson       String?

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  readings         EnergyReading[]
  occupancyRecords OccupancyRecord[]
  files            ImportFile[]
  rejectedRows     ImportRejectedRow[]
  schedules        OperationalSchedule[]
  calendarEvents   AcademicCalendarEvent[]

  @@unique([organizationId, requestFingerprint])
  @@index([organizationId, dataSource])
  @@index([fileSha256])
  @@index([organizationId, status, importedAt])
}

model ImportFile {
  id               String   @id @default(uuid())
  batchId          String
  fieldName        String
  originalFilename String
  sha256           String
  sizeBytes        Int
  mediaType        String?
  storagePath      String
  createdAt        DateTime @default(now())

  batch DataImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([sha256])
}

model ImportRejectedRow {
  id                 String   @id @default(uuid())
  batchId            String
  fileField          String?
  rowNumber          Int
  externalBuildingId String?
  externalMeterId    String?
  rawTimestamp       String?
  rawValue           String?
  reason             String
  qualityStatus      String   @default("INVALID_REJECTED")
  createdAt          DateTime @default(now())

  batch DataImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
}

model BenchmarkEvaluationRun {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  modelType      String // XGBOOST, RANDOM_FOREST, SEASONAL_NAIVE, MILP_OPTIMIZER, ISOLATION_FOREST
  horizonHours   Int
  trainStart     DateTime
  trainEnd       DateTime
  valStart       DateTime?
  valEnd         DateTime?
  testStart      DateTime
  testEnd        DateTime

  mae            Float?
  rmse           Float?
  mape           Float?
  baselineMae    Float?
  improvementPct Float?

  configurationJson String
  metricsReportJson String?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, modelType])
}
